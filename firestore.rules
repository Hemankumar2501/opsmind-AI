rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 255;
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(workspaceId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow update: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid);
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // Support tickets
    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(ticketId)
        && request.resource.data.workspaceId is string
        && request.resource.data.customerName is string
        && request.resource.data.subject is string;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Knowledge Documents
    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(documentId)
        && request.resource.data.workspaceId is string
        && request.resource.data.fileName is string;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // AI Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.workspaceId is string);
      allow create: if isSignedIn()
        && isValidId(conversationId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && isValidId(messageId)
          && request.resource.data.content is string;
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    // Agent Executions Log
    match /agentExecutions/{executionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(executionId)
        && request.resource.data.agentName is string;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(notificationId)
        && request.resource.data.title is string;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
